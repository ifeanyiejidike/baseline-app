# Local development only. Production deploy is expected via Vercel (see the
# root .gitignore's `.vercel` entry) — this image exists purely so
# `docker compose up` at the monorepo root can run the whole stack,
# frontend included, without a separate `npm install` step on the host.
FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000
CMD ["npm", "run", "dev"]
