# Copy to .env.local for local dev overrides. Never commit real secrets —
# only NEXT_PUBLIC_* vars are exposed to the browser bundle; anything else
# (none currently needed) would stay server-only.

# Baseline API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# This site's own public URL (used for canonical links, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# EmailJS (contact/lead-capture form) — see https://www.emailjs.com/
# All three are PUBLIC values by EmailJS's own design (the public key is
# meant to be client-exposed; abuse is rate-limited on their end, not kept
# secret here) — safe to expose via NEXT_PUBLIC_*.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
